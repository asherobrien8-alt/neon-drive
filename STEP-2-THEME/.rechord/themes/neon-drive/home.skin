[skin]
refresh_ms=90
refresh_h=170
[vars]
fk=(mod(t, 2300) < 70 || (mod(t, 2300) > 2150 && mod(t, 2300) < 2185) || mod(t, 1300) < 22)
tr=(fk ? 30884 : 63815)
ph=mod(t / 70, 14)
pq=mod(t / 70 + 7, 14)
c1=(ph < 5 ? 64201 : (ph < 10 ? 39239 : 14500))
c2=(pq < 5 ? 64201 : (pq < 10 ? 39239 : 14500))
al=(mod(t, 1400) < 700 ? 63945 : 14500)
