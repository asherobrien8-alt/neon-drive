[vars]
fk=(mod(t, 2300) < 70 || (mod(t, 2300) > 2150 && mod(t, 2300) < 2185) || mod(t, 1300) < 22)
tr=(fk ? (mod(t, 60) < 30 ? 30884 : 7248) : 63815)
jx=(fk ? 2 - mod(t / 20, 5) : 0)
gy=27 + mod(t / 30, 13)
sa=(mod(t, 3100) < 2700 || mod(t, 140) < 60)
sb=(mod(t + 1700, 4300) < 3900 || mod(t, 110) < 40)
sc=(mod(t + 900, 5200) < 4300 || mod(t, 190) < 70)
