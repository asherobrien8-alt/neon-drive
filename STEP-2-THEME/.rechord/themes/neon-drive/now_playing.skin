x=8
y=86
w=92
h=14
r=2
color=16284
[badge2]
type=fill
x=9
y=87
w=90
h=12
color=4195
[fmt]
type=text
x=54
y=89
text=(bits > 0 ? bits + "BIT " + (rate / 1000) + "K" : "AUDIO")
align=center
color=16284
[hr]
type=text
x=106
y=89
text="HI-RES"
color=47083
visible=bits > 16 || rate > 48000
[sky]
type=gradient
x=212
y=24
w=100
h=60
from=35
to=14442
dir=vertical
[sun]
