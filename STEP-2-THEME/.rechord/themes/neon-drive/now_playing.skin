[skin]
refresh_ms=60
dyn=0,0,319,18
dyn2=0,106,319,143
dyn3=0,144,319,169
[vars]
tx=10 + (volume + 60) * 284 / 60
fl=(tx < rx ? 1 : (tx > rx ? 0 : fl))
mv=(tx != rx)
lt=(mv ? t : lt)
rx=(abs(tx - rx) > 320 ? tx : rx + clamp(tx - rx, -6, 6))
rn=(t - lt < 450)
fr=(rn ? mod(t, 220) < 110 : 1)
lv=volume + 60
[bg]
type=fill
x=0
y=0
w=W
h=H
color=4195
[top]
type=fill
x=0
y=0
w=W
h=18
color=4195
dyn=1
[state]
type=text
x=8
y=6
text=(playing ? "PLAY" : (paused ? "PAUSE" : "STOP"))
color=(playing ? 16284 : 35894)
dyn=1
[trk]
type=text
x=160
y=6
text=(pl_n > 0 ? "TRACK " + pl_i + "/" + pl_n : "")
align=center
color=35894
dyn=1
[bat]
type=text
x=312
y=6
text=(battery < 0 ? "--" : battery + "%")
align=right
color=61375
dyn=1
[npl]
type=text
x=8
y=26
text="NOW PLAYING"
color=63945
[title]
type=text
x=8
y=38
text=title
scale=2
maxc=12
color=61375
[by]
type=text
x=8
y=60
text="BY"
color=63945
[artist]
type=text
x=30
y=60
text=artist
maxc=22
color=61375
[album]
type=text
x=8
y=72
