dyn=1
[spd2]
type=fill
x=(fl ? rx + 20 : rx - 18)
y=124
w=12
h=1
color=7248
visible=rn
dyn=1
[g1]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx - 1
y=112
flip=fl
color=7021
bg=none
dyn=1
[g2]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx + 1
y=112
flip=fl
color=7021
bg=none
dyn=1
[g3]
type=bitmap
asset=(fr ? run_b : run_a)
