new file mode 100644
index 0000000..24d12f8
--- /dev/null
+++ b/firmware/services/tests/test_search_az.c
@@ -0,0 +1,88 @@
+/*
+ * test_search_az.c — Neon Drive: mq_search_init + A-Z helpers.
+ */
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "fs.h"
+#include "fs_host.h"
+#include "media_db.h"
+#include "media_query.h"
+#include "scratch.h"
+
+static int s_checks, s_failures;
+#define CHECK(c) do { s_checks++; if (!(c)) { printf("FAIL %s:%d: %s\n", __FILE__, __LINE__, #c); s_failures++; } } while (0)
+
+static void add(const char *title, const char *artist, const char *album)
+{
+    media_rec_t r;
+
+    memset(&r, 0, sizeof r);
+    snprintf(r.path, sizeof r.path, "Internal/Music/%s.flac", title);
+    snprintf(r.title, sizeof r.title, "%s", title);
+    snprintf(r.artist, sizeof r.artist, "%s", artist);
+    snprintf(r.album, sizeof r.album, "%s", album);
+    (void)media_db_add(&r);
+}
+
+int main(void)
+{
+    static uint8_t buf[SCRATCH_BYTES];
+    media_rec_t r;
+
+    printf("== media_query: search + A-Z ==\n");
+    (void)mkdir(".work", 0777);
+    (void)mkdir(".work/Internal", 0777);
+    (void)mkdir(".work/Internal/.rechord", 0777);
+    fs_host_set_root(".work");
+    (void)remove(".work/Internal/.rechord/INDEX.A");
+    (void)remove(".work/Internal/.rechord/INDEX.B");
+
+    CHECK(media_db_begin(buf, (uint32_t)sizeof buf) == FS_OK);
+    add("Nightcall", "Kavinsky", "OutRun");
+    add("Midnight City", "M83", "Hurry Up");
+    add("Mid-Air Blade", "Chrome Samurai", "Steel");
+    add("Roadgame", "Kavinsky", "OutRun");
+    add("the Driver", "Midnight Katana", "Neon");
+    add("99 Lights", "Lazerhawk", "Redline");
+    CHECK(media_db_end() == FS_OK);
+
+    /* search: title OR artist OR album, case-insensitive, title-sorted */
+    CHECK(mq_search_init("mid") == 0);
+    CHECK(mq_filter_count() == 3);              /* 2 titles + Midnight Katana */
+    CHECK(mq_filter_get(0, &r) == FS_OK && strcmp(r.title, "Mid-Air Blade") == 0);
+    CHECK(strcmp(mq_sort_key(1), "Midnight City") == 0);
+    CHECK(mq_search_init("OUTRUN") == 0 && mq_filter_count() == 2);
+    CHECK(mq_search_init("zzz") == 0 && mq_filter_count() == 0);
+    CHECK(mq_search_init("") == 0 && mq_filter_count() == 0);
+
+    /* initials follow the sort text (no "The" skipping), digits are '#' */
+    CHECK(mq_initial_of("The Midnight") == 'T');
+    CHECK(mq_initial_of("the Driver") == 'T');
+    CHECK(mq_initial_of("99 Lights") == '#');
+    CHECK(mq_initial_of("kavinsky") == 'K');
+    CHECK(mq_initial_of("Theory") == 'T');
+
+    /* A-Z on All Songs (sorted: 99, Mid-Air, Midnight, Nightcall, Road, the Driver) */
+    CHECK(mq_filter_init(MQ_ALL, 0) == 0);
+    CHECK(mq_initial_count('M') == 2);
+    CHECK(mq_initial_index('#') == 0);
+    CHECK(mq_initial_index('M') == 1);
+    CHECK(mq_initial_index('N') == 3);
+    CHECK(mq_initial_index('O') == 4);          /* no O: next letter (R) */
+    CHECK(mq_initial_index('T') == 5);          /* "the Driver" sorts as t */
+    CHECK(mq_initial_index('D') == 1);          /* no D: next letter that exists (M) */
+    CHECK(mq_initial_index('Z') == 5);          /* past the end: last row */
+
+    /* A-Z on names */
+    CHECK(mq_names_init(MQ_ARTIST) == 0);
+    CHECK(mq_initial_count('K') == 1);
+    CHECK(mq_initial_index('L') >= 0);
+    CHECK(strcmp(mq_names_get((unsigned)mq_initial_index('L')), "Lazerhawk") == 0);
+    mq_done();
+    CHECK(mq_initial_index('A') == -1);         /* empty list */
+
+    printf("%d checks, %d failures\n", s_checks, s_failures);
+    return s_failures != 0;
+}
