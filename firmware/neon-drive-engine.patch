diff --git a/firmware/services/media_query.c b/firmware/services/media_query.c
index f7fae68..f47d4b6 100644
--- a/firmware/services/media_query.c
+++ b/firmware/services/media_query.c
@@ -440,3 +440,121 @@ void mq_done(void)
     s_cap = 0;
     s_truncated = 0;
 }
+
+/* ---- Neon Drive: Search + A-Z jump ------------------------------------- */
+
+static int ci_contains(const char *hay, const char *needle)
+{
+    size_t i, n = strlen(needle);
+
+    if (n == 0u)
+        return 0;
+    for (; *hay != '\0'; hay++) {
+        for (i = 0; i < n; i++) {
+            unsigned char a = (unsigned char)hay[i];
+            unsigned char b = (unsigned char)needle[i];
+
+            if (a == '\0')
+                return 0;
+            if (a >= 'A' && a <= 'Z') a = (unsigned char)(a + 32);
+            if (b >= 'A' && b <= 'Z') b = (unsigned char)(b + 32);
+            if (a != b)
+                break;
+        }
+        if (i == n)
+            return 1;
+    }
+    return 0;
+}
+
+int mq_search_init(const char *query)
+{
+    unsigned total, i;
+
+    mq_done();
+    mq_setup_lists(&s_cap);
+    if (s_idx == 0)
+        return FS_ERR_IO;
+    s_count = 0;
+    s_truncated = 0;
+    if (query == 0 || query[0] == '\0')
+        return 0;
+    if (media_db_open() != FS_OK) {
+        mq_done();
+        return FS_ERR_OPEN;
+    }
+    total = media_db_count();
+    for (i = 0; i < total; i++) {
+        media_rec_t rec;
+
+        if (media_db_get(i, &rec) != FS_OK)
+            break;
+        if (s_pump != 0 && (i & (MQ_PUMP_EVERY - 1u)) == 0u)
+            s_pump();
+        if (!ci_contains(rec.title, query) && !ci_contains(rec.artist, query) &&
+            !ci_contains(rec.album, query))
+            continue;
+        if (s_count >= s_cap) {
+            s_truncated = 1;
+            break;
+        }
+        s_idx[s_count] = (uint16_t)i;
+        mq_key_set(&s_key[s_count], rec.track_no, rec.title);
+        s_count++;
+    }
+    mq_sort_items();
+    return 0;
+}
+
+const char *mq_sort_key(unsigned i)
+{
+    if (s_key == 0 || s_idx == 0 || i >= s_count)
+        return 0;
+    return s_key[i].text;
+}
+
+char mq_initial_of(const char *s)
+{
+    unsigned char c;
+
+    if (s == 0)
+        return '#';
+    c = (unsigned char)s[0];
+    if (c >= 'a' && c <= 'z')
+        c = (unsigned char)(c - 32);
+    return (c >= 'A' && c <= 'Z') ? (char)c : '#';
+}
+
+static const char *mq_row_text(unsigned i)
+{
+    return s_key != 0 ? mq_sort_key(i) : mq_names_get(i);
+}
+
+int mq_initial_index(char letter)
+{
+    unsigned i;
+    int after = -1;
+
+    if (s_count == 0u)
+        return -1;
+    for (i = 0; i < s_count; i++) {
+        char c = mq_initial_of(mq_row_text(i));
+
+        if (c == letter)
+            return (int)i;
+        /* '#' sorts first; past the letter = the next one alphabetically */
+        if (after < 0 && letter != '#' && c != '#' && c > letter)
+            after = (int)i;
+    }
+    return after >= 0 ? after : (letter == '#' ? 0 : (int)s_count - 1);
+}
+
+unsigned mq_initial_count(char letter)
+{
+    unsigned i, n = 0;
+
+    for (i = 0; i < s_count; i++)
+        if (mq_initial_of(mq_row_text(i)) == letter)
+            n++;
+    return n;
+}
