+/* ---- Neon Drive: Search + A-Z jump ------------------------------------- */
+
+static int ci_contains(const char *hay, const char *needle)
+{
+    size_t i, n = strlen(needle);
+
+    if (n == 0u)
+        return 0;
+    for (; *hay != '\0'; hay++) {
+        for (i = 0; i < n; i++) {
+            unsigned char a = (unsigned char)hay[i];
+            unsigned char b = (unsigned char)needle[i];
+
+            if (a == '\0')
+                return 0;
+            if (a >= 'A' && a <= 'Z') a = (unsigned char)(a + 32);
+            if (b >= 'A' && b <= 'Z') b = (unsigned char)(b + 32);
+            if (a != b)
+                break;
+        }
+        if (i == n)
+            return 1;
+    }
+    return 0;
+}
+
+int mq_search_init(const char *query)
+{
+    unsigned total, i;
+
+    mq_done();
+    mq_setup_lists(&s_cap);
+    if (s_idx == 0)
+        return FS_ERR_IO;
+    s_count = 0;
+    s_truncated = 0;
+    if (query == 0 || query[0] == '\0')
+        return 0;
+    if (media_db_open() != FS_OK) {
+        mq_done();
+        return FS_ERR_OPEN;
+    }
+    total = media_db_count();
+    for (i = 0; i < total; i++) {
+        media_rec_t rec;
+
+        if (media_db_get(i, &rec) != FS_OK)
+            break;
+        if (s_pump != 0 && (i & (MQ_PUMP_EVERY - 1u)) == 0u)
+            s_pump();
+        if (!ci_contains(rec.title, query) && !ci_contains(rec.artist, query) &&
+            !ci_contains(rec.album, query))
+            continue;
+        if (s_count >= s_cap) {
+            s_truncated = 1;
+            break;
+        }
+        s_idx[s_count] = (uint16_t)i;
+        mq_key_set(&s_key[s_count], rec.track_no, rec.title);
+        s_count++;
+    }
+    mq_sort_items();
+    return 0;
+}
+
+const char *mq_sort_key(unsigned i)
+{
+    if (s_key == 0 || s_idx == 0 || i >= s_count)
+        return 0;
+    return s_key[i].text;
+}
+
+char mq_initial_of(const char *s)
+{
+    unsigned char c;
+
+    if (s == 0)
+        return '#';
+    c = (unsigned char)s[0];
+    if (c >= 'a' && c <= 'z')
+        c = (unsigned char)(c - 32);
+    return (c >= 'A' && c <= 'Z') ? (char)c : '#';
+}
+
+static const char *mq_row_text(unsigned i)
+{
+    return s_key != 0 ? mq_sort_key(i) : mq_names_get(i);
+}
+
+int mq_initial_index(char letter)
+{
+    unsigned i;
+    int after = -1;
+
+    if (s_count == 0u)
+        return -1;
+    for (i = 0; i < s_count; i++) {
+        char c = mq_initial_of(mq_row_text(i));
+
+        if (c == letter)
+            return (int)i;
+        /* '#' sorts first; past the letter = the next one alphabetically */
+        if (after < 0 && letter != '#' && c != '#' && c > letter)
+            after = (int)i;
+    }
+    return after >= 0 ? after : (letter == '#' ? 0 : (int)s_count - 1);
+}
+
+unsigned mq_initial_count(char letter)
+{
+    unsigned i, n = 0;
+
+    for (i = 0; i < s_count; i++)
+        if (mq_initial_of(mq_row_text(i)) == letter)
+            n++;
+    return n;
+}
+
+/* ---- Neon Drive: playlists (.m3u / .m3u8) ------------------------------
+ *
+ * One copy of every song, any number of playlists (iPod-style): a playlist
+ * is a text file of paths in /Internal/Playlists or /SD/Playlists, and its
+ * entries are matched to media-index records by path. Accepted entry forms:
+ *   /Internal/Music/A/x.flac  (device path)      Internal/Music/A/x.flac
+ *   ../Music/A/x.flac         (relative to the playlist's folder)
+ *   Music/A/x.flac            (relative to the playlist's volume)
+ * Backslashes count as '/', matching ignores ASCII case (FAT does). Lines
+ * starting with '#' (#EXTM3U, #EXTINF) are skipped. Missing songs are
+ * dropped silently; the order of the file is kept. */
+
+#define MQ_PL_DIR_INT "/Internal/Playlists"
+#define MQ_PL_DIR_SD  "/SD/Playlists"
+
+typedef struct { uint32_t hash; uint16_t pos; } mq_pl_ent_t;
+
+static uint32_t pl_hash(const char *s)
+{
+    uint32_t h = 2166136261u;
+
+    for (; *s; s++) {
+        unsigned char c = (unsigned char)*s;
+
+        if (c == '\\')
+            c = '/';
+        if (c >= 'A' && c <= 'Z')
+            c = (unsigned char)(c + 32);
+        h = (h ^ c) * 16777619u;
+    }
+    return h;
+}
+
+static int pl_is_list(const char *name, char *base, unsigned cap)
+{
+    size_t n = strlen(name);
+    size_t k;
+
+    if (n > 5 && (strcmp(name + n - 5, ".m3u8") == 0 || strcmp(name + n - 5, ".M3U8") == 0))
+        k = n - 5;
+    else if (n > 4 && (strcmp(name + n - 4, ".m3u") == 0 || strcmp(name + n - 4, ".M3U") == 0))
+        k = n - 4;
+    else
+        return 0;
+    if (name[0] == '.' || k == 0)
+        return 0;                       /* macOS ._ files and the like */
+    if (k > cap - 1u)
+        k = cap - 1u;
+    memcpy(base, name, k);
+    base[k] = '\0';
+    return 1;
+}
+
+static int pl_list_cb(const char *name, int is_dir)
+{
+    char base[MQ_CELL];
+    unsigned k;
+
+    if (is_dir || !pl_is_list(name, base, sizeof base))
+        return 0;
+    for (k = 0; k < s_count; k++)
+        if (strcmp(s_cells + k * MQ_CELL, base) == 0)
+            return 0;
+    if (s_count >= s_cap)
+        return 1;
+    memset(s_cells + s_count * MQ_CELL, 0, MQ_CELL);
+    memcpy(s_cells + s_count * MQ_CELL, base, strlen(base));
+    s_count++;
+    return 0;
+}
+
+int mq_playlists_init(void)
+{
+    mq_done();
+    s_cells = scratch_claim(SCRATCH_OWNER_INDEX);
+    if (s_cells == 0)
+        return FS_ERR_IO;
+    s_key = 0;
+    s_cap = SCRATCH_BYTES / MQ_CELL;
+    s_count = 0;
+    s_truncated = 0;
+    (void)fs_list_dir_each(MQ_PL_DIR_INT, pl_list_cb);
+    (void)fs_list_dir_each(MQ_PL_DIR_SD, pl_list_cb);
+    sort_names();
+    return 0;
+}
+
+/* Normalize one playlist line to the index key form ("Internal/Music/..."). */
+static int pl_normalize(const char *line, const char *vol, char *out, unsigned cap)
+{
+    char tmp[MEDIA_PATH_MAX + 16];
+    char *seg[24];
+    unsigned nseg = 0, i, o = 0;
+    char *p;
+
+    while (*line == ' ' || *line == '\t')
+        line++;
+    if (line[0] == '\0' || line[0] == '#')
+        return 0;
+    if (strlen(line) >= sizeof tmp - 16u)
+        return 0;
+    if (line[0] == '/' || line[0] == '\\') {
+        snprintf(tmp, sizeof tmp, "%s", line + 1);              /* device path */
+    } else if (strncmp(line, "../", 3) == 0 || strncmp(line, "..\\", 3) == 0 ||
+               strncmp(line, "./", 2) == 0) {
+        snprintf(tmp, sizeof tmp, "%s/Playlists/%s", vol, line); /* relative */
+    } else if ((strncmp(line, "Internal", 8) == 0 || strncmp(line, "SD", 2) == 0) &&
+               (line[line[0] == 'S' ? 2 : 8] == '/' || line[line[0] == 'S' ? 2 : 8] == '\\')) {
+        snprintf(tmp, sizeof tmp, "%s", line);
+    } else {
+        snprintf(tmp, sizeof tmp, "%s/%s", vol, line);           /* volume-relative */
+    }
+    for (p = tmp; *p; p++)
+        if (*p == '\\')
+            *p = '/';
+    /* resolve "." and ".." */
+    p = tmp;
+    while (*p && nseg < 24u) {
+        char *s = p;
+
+        while (*p && *p != '/')
+            p++;
+        if (*p)
+            *p++ = '\0';
+        if (s[0] == '\0' || strcmp(s, ".") == 0)
+            continue;
+        if (strcmp(s, "..") == 0) {
+            if (nseg > 0u)
+                nseg--;
+            continue;
+        }
+        seg[nseg++] = s;
+    }
+    for (i = 0; i < nseg; i++) {
+        size_t n = strlen(seg[i]);
+
+        if (o + n + 2u > cap)
+            return 0;
+        if (i)
+            out[o++] = '/';
+        memcpy(out + o, seg[i], n);
+        o += (unsigned)n;
+    }
+    out[o] = '\0';
+    return o > 0u;
+}
+
+static int pl_ent_cmp_insert(mq_pl_ent_t *e, unsigned n, mq_pl_ent_t v)
+{
+    unsigned j = n;
+
+    while (j > 0 && e[j - 1].hash > v.hash) {
+        e[j] = e[j - 1];
+        j--;
+    }
+    e[j] = v;
+    return 0;
+}
+
+int mq_playlist_init(const char *name)
