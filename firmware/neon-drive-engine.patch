+/*
+ * neon_fx.c — Neon Drive boot and power-off animations.
+ *
+ * Boot (~1.9 s): the theme's alley shop. The roll-up shutter lifts (shutter
+ * rows slide up, the lit shop is revealed from the bottom), the neon sign
+ * flickers on ("電源オン", pre-rendered), and a segmented neon bar fills.
+ * Pictures are raw RGB565 files in <theme>/img/ streamed through the art
+ * pack's sector buffer: no RAM, and no files means no animation (plain boot).
+ *
+ * Power-off (3 s): a "virus" wipe. A corrupted, glitching front sweeps
+ * diagonally from the top-right corner to the bottom-left; behind it the
+ * screen is dead black. Then the caller powers down.
+ *
+ * Everything is clock-driven (frames are dropped, never slowed down) and uses
+ * only stack/static ints.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "neon_fx.h"
+#include "../drivers/display.h"
+#include "../services/art_pack.h"
+#include "../theme/theme_runtime.h"
+#include "../services/rechord_files.h"
+
+void ui_text_scaled(int x, int y, const char *s, int scale, uint16_t fg);
+
+/* geometry shared with art/render_boot.py */
+#define DOOR_X 104
+#define DOOR_Y 74
+#define DOOR_W 112
+#define DOOR_H 70
+#define SIGN_X 96
+#define SIGN_Y 26
+#define SIGN_W 128
+#define SIGN_H 34
+
+#define C565(r, g, b) ((uint16_t)((((r) >> 3) << 11) | (((g) >> 2) << 5) | ((b) >> 3)))
+
+static char s_p_shut[112], s_p_open[112], s_p_sign[112];
+
+static int img_paths(void)
+{
+    const char *id = theme_pkg_active_id();
+
+    if (id == 0 || id[0] == '\0')
+        return -1;
+    snprintf(s_p_shut, sizeof s_p_shut, RECHORD_THEMES_DIR "/%s/img/boot_shut.565", id);
+    snprintf(s_p_open, sizeof s_p_open, RECHORD_THEMES_DIR "/%s/img/boot_open.565", id);
+    snprintf(s_p_sign, sizeof s_p_sign, RECHORD_THEMES_DIR "/%s/img/boot_sign.565", id);
+    return 0;
+}
+
+/* segmented neon loading bar along the street */
+static void boot_bar(int pct)
+{
+    const int x0 = 60, y0 = 154, segs = 25, sw = 7;
+    char buf[16];
+    int i, lit = pct * segs / 100;
+
+    display_fill_rect(x0 - 6, y0 - 4, x0 + segs * (sw + 1) + 44, y0 + 11, C565(8, 6, 18));
+    display_fill_rect(x0 - 3, y0 - 2, x0 + segs * (sw + 1) + 1, y0 - 2, C565(63, 240, 224));
+    display_fill_rect(x0 - 3, y0 + 9, x0 + segs * (sw + 1) + 1, y0 + 9, C565(63, 240, 224));
+    for (i = 0; i < segs; i++) {
+        int x = x0 + i * (sw + 1);
+        /* pink -> cyan along the bar */
+        uint16_t c = C565(255 - i * 8, 63 + i * 7, 191 + i);
+
+        display_fill_rect(x, y0, x + sw - 1, y0 + 6, i < lit ? c : C565(30, 22, 48));
+    }
+    snprintf(buf, sizeof buf, "%3d%%", pct);
+    display_draw_text(x0 + segs * (sw + 1) + 6, y0, buf, C565(255, 255, 255), C565(8, 6, 18));
+    display_flush_rect(x0 - 6, y0 - 4, x0 + segs * (sw + 1) + 44, y0 + 11);
+}
+
+static int s_b_rv, s_b_sign, s_b_pct;
+
+int neon_boot_begin(void)
+{
+    if (img_paths() != 0)
+        return -1;
+    if (art_pack_blit_file(s_p_shut, 0, 0, DISPLAY_W, DISPLAY_H, 0, 0, DISPLAY_W, 0) != 0)
+        return -1;                                /* no boot art: plain boot */
+    display_flush_rows(0, DISPLAY_H - 1);
+    boot_bar(0);
+    s_b_rv = -1;
+    s_b_sign = -1;
+    s_b_pct = -1;
+    return 0;
+}
+
+/* one frame at t ms since begin; returns 1 when finished */
+int neon_boot_frame(unsigned t)
+{
+    int rv, sign, pct;
+
+    if (t > 1950u) {
+        boot_bar(100);
+        return 1;
+    }
+    /* shutter: 200..1100 ms, ease-out */
+    if (t < 200u)
+        rv = 0;
+    else if (t >= 1100u)
+        rv = DOOR_H;
+    else {
+        int p = (int)(t - 200u) * 1000 / 900;          /* 0..1000 */
+        int e = 1000 - (1000 - p) * (1000 - p) / 1000;
+
+        rv = e * DOOR_H / 1000;
+    }
+    if (rv != s_b_rv) {
+        int split = DOOR_Y + DOOR_H - rv;              /* shutter bottom edge */
+
+        if (DOOR_H - rv > 0)                           /* slats slide up */
+            art_pack_blit_file(s_p_shut, DOOR_X, DOOR_Y, DOOR_W, DOOR_H - rv,
+                               DOOR_X, DOOR_Y + rv, DISPLAY_W, 0);
+        if (rv > 0)                                    /* the lit shop */
+            art_pack_blit_file(s_p_open, DOOR_X, split, DOOR_W, rv,
+                               DOOR_X, split, DISPLAY_W, 0);
+        if (rv < DOOR_H)                               /* shutter lip + shadow */
+            display_fill_rect(DOOR_X, split - 2, DOOR_X + DOOR_W - 1, split - 1,
+                              C565(20, 22, 36));
+        display_flush_rect(DOOR_X, DOOR_Y, DOOR_X + DOOR_W - 1, DOOR_Y + DOOR_H - 1);
+        s_b_rv = rv;
+    }
+    /* sign: dead until 1150 ms, then a neon stutter, then on */
+    sign = (t >= 1150u && t < 1210u) || (t >= 1290u && t < 1320u) ||
+           (t >= 1380u && t < 1400u) || t >= 1460u;
+    if (sign != s_b_sign) {
+        if (sign)
+            art_pack_blit_file(s_p_sign, SIGN_X, SIGN_Y, SIGN_W, SIGN_H, 0, 0, SIGN_W, 0);
+        else
+            art_pack_blit_file(s_p_shut, SIGN_X, SIGN_Y, SIGN_W, SIGN_H,
+                               SIGN_X, SIGN_Y, DISPLAY_W, 0);
+        display_flush_rect(SIGN_X, SIGN_Y, SIGN_X + SIGN_W - 1, SIGN_Y + SIGN_H - 1);
+        s_b_sign = sign;
+    }
+    pct = t >= 1800u ? 100 : (int)(t * 100u / 1800u);
+    if (pct / 4 != s_b_pct / 4) {
+        boot_bar(pct);
+        s_b_pct = pct;
+    }
+    return 0;
+}
+
+void neon_boot_anim(unsigned (*now_ms)(void))
+{
+    unsigned t0;
+
+    if (now_ms == 0 || neon_boot_begin() != 0)
+        return;
+    t0 = now_ms();
+    while (!neon_boot_frame(now_ms() - t0))
+        ;
+}
+
+/* ---- power-off: diagonal virus wipe ------------------------------------ */
+
+static unsigned s_rnd = 0x2077u;
+
+static unsigned rnd(void)
+{
+    s_rnd = s_rnd * 1103515245u + 12345u;
+    return s_rnd >> 16;
+}
+
+#define CELL 8
+#define COLS (DISPLAY_W / CELL)                    /* 40 */
+#define ROWS ((DISPLAY_H + CELL - 1) / CELL)       /* 22 */
+#define DIAG (COLS + ROWS)                         /* 62 diagonals */
+#define BAND 5                                     /* glitch front width */
+
+static void glitch_cell(int cx, int cy)
+{
+    static const uint16_t pal[] = {
+        C565(255, 63, 191), C565(63, 240, 224), C565(182, 255, 90),
+        C565(255, 59, 79), C565(240, 240, 255), C565(0, 0, 0), C565(40, 0, 60) };
+    int x = cx * CELL, y = cy * CELL, q;
+
+    for (q = 0; q < 4; q++) {                       /* 4x4 sub-blocks */
+        int sx = x + (q & 1) * 4, sy = y + (q >> 1) * 4;
+        unsigned r = rnd();
+
+        display_fill_rect(sx, sy, sx + 3, sy + 3, pal[r % 7u]);
+    }
+    if ((rnd() & 7u) == 0u)                          /* horizontal tear */
+        display_fill_rect(x - CELL * (int)(rnd() % 6u), y + (int)(rnd() % 8u),
+                          x + CELL, y + (int)(rnd() % 8u), pal[rnd() % 4u]);
+}
+
+static int s_dead;                                  /* diagonals already black */
+
+void neon_off_begin(void)
+{
+    s_dead = 0;
+}
+
+int neon_off_frame(unsigned t)
+{
+    int front, k, cx;
+
+    if (t >= 3000u) {
+        display_fill_rect(0, 0, DISPLAY_W - 1, DISPLAY_H - 1, 0x0000);
+        display_flush_rows(0, DISPLAY_H - 1);
+        return 1;
+    }
+    /* the front runs through all diagonals plus the band, ease-in */
+    front = (int)((unsigned long)t * t / 3000u * (DIAG + BAND) / 3000u);
+    /* everything behind the band dies */
+    for (; s_dead < front - BAND && s_dead < DIAG; s_dead++)
+        for (cx = 0; cx < COLS; cx++) {
+            int cy = s_dead - (COLS - 1 - cx);
+
+            if (cy >= 0 && cy < ROWS)
+                display_fill_rect(cx * CELL, cy * CELL, cx * CELL + CELL - 1,
+                                  cy * CELL + CELL - 1, 0x0000);
+        }
+    /* the band boils */
+    for (k = front - BAND; k <= front; k++) {
+        if (k < s_dead || k >= DIAG)
+            continue;
+        for (cx = 0; cx < COLS; cx++) {
+            int cy = k - (COLS - 1 - cx);
+
+            if (cy >= 0 && cy < ROWS && (rnd() & 3u) != 0u)
+                glitch_cell(cx, cy);
+        }
+    }
+    /* a last gasp across the middle */
+    if (t > 900u && t < 1500u && (rnd() & 1u))
+        ui_text_scaled(56 + (int)(rnd() % 5u) - 2, 74, "SIGNAL LOST", 2,
+                       (rnd() & 1u) ? C565(255, 59, 79) : C565(63, 240, 224));
+    display_flush_rows(0, DISPLAY_H - 1);
+    return 0;
+}
+
+void neon_poweroff_anim(unsigned (*now_ms)(void))
+{
+    unsigned t0;
+
+    if (now_ms == 0)
+        return;
+    neon_off_begin();
+    t0 = now_ms();
+    while (!neon_off_frame(now_ms() - t0))
+        ;
+}
