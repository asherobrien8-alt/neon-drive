diff --git a/firmware/ui/screens/az_screen.c b/firmware/ui/screens/az_screen.c
new file mode 100644
index 0000000..a65556f
--- /dev/null
+++ b/firmware/ui/screens/az_screen.c
@@ -0,0 +1,142 @@
+/*
+ * az_screen.c — A-Z jump overlay (Neon Drive).
+ *
+ * Opened by holding PLAY on a long list (category names, All Songs, search
+ * results). A 7x4 letter grid: VOL moves the letter, PLAY jumps the list to
+ * the first row with that initial, BACK cancels. The right panel shows the
+ * letter big and how many rows start with it, so you never jump into nothing
+ * by surprise. All list knowledge comes from media_query (mq_initial_*), so
+ * this screen only draws and routes keys. Colours come from the active theme.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "screens.h"
+#include "../theme.h"
+#include "../internal/hal.h"
+#include "../../drivers/font.h"
+#include "../../services/media_query.h"
+
+static const char k_letters[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZ#";
+#define AZ_N    27
+#define AZ_COLS 7
+
+static int  s_sel;
+static char s_noun[12];
+static void (*s_jump)(int row);
+static int  s_armed;      /* PLAY went down on THIS screen */
+
+void ui_text_scaled(int x, int y, const char *s, int scale, uint16_t fg)
+{
+    for (; *s != '\0'; s++, x += 8 * scale) {
+        const uint8_t *g = font_glyph((uint8_t)*s);
+        int r, c;
+
+        for (r = 0; r < 8; r++)
+            for (c = 0; c < 8; c++)
+                if (g[r] & (0x80u >> c))
+                    display_fill_rect(x + c * scale, y + r * scale,
+                                      x + c * scale + scale - 1,
+                                      y + r * scale + scale - 1, fg);
+    }
+}
+
+void az_screen_open(const char *noun, const char *current, void (*jump)(int row))
+{
+    char cur = mq_initial_of(current);
+    const char *p = strchr(k_letters, cur);
+
+    s_sel = p != 0 ? (int)(p - k_letters) : 0;
+    snprintf(s_noun, sizeof s_noun, "%s", noun != 0 ? noun : "ROWS");
+    s_jump = jump;
+    s_armed = 0;
+    ui_push_screen(&az_screen);
+}
+
+static void az_draw(void)
+{
+    char buf[24];
+    char letter[2] = { k_letters[s_sel], '\0' };
+    unsigned n = mq_initial_count(k_letters[s_sel]);
+    int i;
+
+    display_clear(THEME_COLOR_BG);
+    display_fill_rect(0, 0, 2, 13, THEME_COLOR_WARN);
+    snprintf(buf, sizeof buf, "A-Z JUMP / %s", s_noun);
+    display_draw_text(8, 4, buf, THEME_COLOR_ACCENT, THEME_COLOR_BG);
+    display_fill_rect(0, 16, DISPLAY_W - 1, 16, THEME_COLOR_DIM);
+
+    for (i = 0; i < AZ_N; i++) {
+        int x = 8 + (i % AZ_COLS) * 28;
+        int y = 22 + (i / AZ_COLS) * 26;
+        char ch[2] = { k_letters[i], '\0' };
+        int has = mq_initial_count(k_letters[i]) > 0u;
+        uint16_t bg = (i == s_sel) ? THEME_COLOR_WARN : THEME_COLOR_SELECT_BG;
+        uint16_t fg = (i == s_sel) ? THEME_COLOR_BG
+                                   : (has ? THEME_COLOR_FG : THEME_COLOR_DIM);
+
+        display_fill_rect(x, y, x + 25, y + 23, bg);
+        ui_text_scaled(x + 5, y + 4, ch, 2, fg);
+    }
+
+    ui_text_scaled(232, 26, letter, 6, n ? THEME_COLOR_ACCENT : THEME_COLOR_DIM);
+    if (n == 1u && s_noun[0] != '\0' && s_noun[strlen(s_noun) - 1] == 'S')
+        snprintf(buf, sizeof buf, "1 %.*s", (int)strlen(s_noun) - 1, s_noun);
+    else if (n)
+        snprintf(buf, sizeof buf, "%u %s", n, s_noun);
+    else
+        snprintf(buf, sizeof buf, "NONE - NEXT");
+    display_draw_text(264 - (int)strlen(buf) * 4, 86, buf,
+                      n ? THEME_COLOR_FG : THEME_COLOR_DIM, THEME_COLOR_BG);
+    display_draw_text(224, 112, "VOL  LETTER", THEME_COLOR_DIM, THEME_COLOR_BG);
+    display_draw_text(224, 124, "PLAY JUMP", THEME_COLOR_DIM, THEME_COLOR_BG);
+    display_draw_text(224, 136, "BACK CANCEL", THEME_COLOR_DIM, THEME_COLOR_BG);
+}
+
+static void az_handle_event(const input_event_t *ev)
+{
+    switch (ev->type) {
+    case KEY_UP:
+    case KEY_DOWN:
+        if (ev->kind != INPUT_PRESS && ev->kind != INPUT_REPEAT)
+            return;
+        s_sel += (ev->type == KEY_DOWN) ? 1 : -1;
+        if (s_sel < 0) s_sel = AZ_N - 1;
+        if (s_sel >= AZ_N) s_sel = 0;
+        ui_invalidate_all();
+        break;
+    case KEY_SELECT:
+        /* the hold that opened us ends here: only presses seen here count */
+        if (ev->kind == INPUT_PRESS) {
+            s_armed = 1;
+            return;
+        }
+        if (ev->kind != INPUT_RELEASE || !s_armed || ev->long_press)
+            return;
+        s_armed = 0;
+        {
+            int row = mq_initial_index(k_letters[s_sel]);
+            void (*jump)(int) = s_jump;
+
+            ui_pop_screen();
+            if (jump != 0 && row >= 0)
+                jump(row);
+        }
+        break;
+    case KEY_BACK:
+        if (ev->kind == INPUT_PRESS)
+            ui_pop_screen();
+        break;
+    default:
+        break;
+    }
+}
+
+const ui_screen_t az_screen = {
+    "a-z",
+    NULL,
+    NULL,
+    az_draw,
+    az_handle_event,
+    0,
+};
