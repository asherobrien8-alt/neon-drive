+    static const char *const k_dirs[2][2] = {
+        { MQ_PL_DIR_INT, "Internal" }, { MQ_PL_DIR_SD, "SD" } };
+    static const char *const k_ext[2] = { ".m3u8", ".m3u" };
+    char path[96], line[MEDIA_PATH_MAX + 16], key[MEDIA_PATH_MAX + 4];
