+/* Neon Drive: average bitrate = file size / duration, measured once per
+ * track (one directory lookup + no data read), cached by path hash. */
+static int track_kbps(const char *path, long dur_ms)
+{
+    static unsigned s_hash;
+    static int s_kbps;
+    unsigned h = 2166136261u;
+    const char *p;
+    fs_file_t *f;
+
+    if (path == 0 || path[0] == '\0' || dur_ms <= 0)
+        return 0;
+    for (p = path; *p; p++)
+        h = (h ^ (unsigned char)*p) * 16777619u;
+    h ^= (unsigned)dur_ms;
+    if (h == s_hash)
+        return s_kbps;
+    s_hash = h;
+    s_kbps = 0;
+    f = fs_open_read(path);
+    if (f != 0) {
+        long sz = fs_file_size(f);
+
+        fs_close(f);
+        if (sz > 0)
+            s_kbps = (int)(((unsigned long long)sz * 8u) / (unsigned long long)dur_ms);
+    }
+    return s_kbps;
+}
