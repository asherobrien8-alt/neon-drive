+        return FS_ERR_IO;
+    s_key = 0;
+    cap = SCRATCH_BYTES / (unsigned)(sizeof(uint16_t) + sizeof(mq_pl_ent_t));
+    ent = (mq_pl_ent_t *)(void *)((uint8_t *)s_idx + cap * sizeof(uint16_t));
+    s_cap = cap;
+    s_count = 0;
+    s_truncated = 0;
+    for (d = 0; d < 2u && f == 0; d++)
+        for (e = 0; e < 2u && f == 0; e++) {
+            snprintf(path, sizeof path, "%s/%s%s", k_dirs[d][0], name, k_ext[e]);
+            f = fs_open_read(path);
+            if (f != 0)
+                vol = k_dirs[d][1];
+        }
+    if (f == 0)
+        return FS_ERR_OPEN;
+    /* pass 1: the entries, as (hash, position) sorted by hash */
+    while ((got = fs_read(f, buf, sizeof buf)) > 0) {
+        for (i = 0; i < (unsigned)got; i++) {
+            char c = (char)buf[i];
+
+            if (c == '\n' || c == '\r') {
+                line[lp] = '\0';
+                lp = 0;
+                if (nent < cap && pl_normalize(line, vol, key, sizeof key)) {
+                    mq_pl_ent_t v;
+
+                    v.hash = pl_hash(key);
+                    v.pos = (uint16_t)nent;
+                    pl_ent_cmp_insert(ent, nent, v);
+                    nent++;
+                } else if (nent >= cap) {
+                    s_truncated = 1;
+                }
+                continue;
+            }
+            if (lp < sizeof line - 1u)
+                line[lp++] = c;
+        }
+    }
+    if (lp > 0u && nent < cap) {
+        line[lp] = '\0';
+        if (pl_normalize(line, vol, key, sizeof key)) {
+            mq_pl_ent_t v;
+
+            v.hash = pl_hash(key);
+            v.pos = (uint16_t)nent;
+            pl_ent_cmp_insert(ent, nent, v);
+            nent++;
+        }
+    }
+    fs_close(f);
+    if (nent == 0u)
+        return 0;
+    for (i = 0; i < nent; i++)
+        s_idx[i] = 0xFFFFu;
+    /* pass 2: one walk over the index fills each playlist position */
+    if (media_db_open() != FS_OK) {
+        mq_done();
+        return FS_ERR_OPEN;
+    }
+    {
+        uint32_t total = media_db_count(), r;
+
+        for (r = 0; r < total && r < 0xFFFFu; r++) {
+            media_rec_t rec;
+            uint32_t h;
+            unsigned lo = 0, hi = nent;
+
+            if (media_db_get(r, &rec) != FS_OK)
+                break;
+            if (s_pump != 0 && (r & (MQ_PUMP_EVERY - 1u)) == 0u)
+                s_pump();
+            h = pl_hash(rec.path);
+            while (lo < hi) {                 /* first entry with this hash */
+                unsigned mid = (lo + hi) / 2u;
+
+                if (ent[mid].hash < h)
+                    lo = mid + 1u;
+                else
+                    hi = mid;
+            }
+            for (; lo < nent && ent[lo].hash == h; lo++)
+                s_idx[ent[lo].pos] = (uint16_t)r;
+        }
+    }
+    /* keep the file's order, drop songs that are not in the index */
+    for (i = 0; i < nent; i++)
+        if (s_idx[i] != 0xFFFFu)
+            s_idx[s_count++] = s_idx[i];
+    return 0;
+}
