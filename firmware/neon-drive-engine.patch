+        s_ls.mark   = prop(sec, "mark")   ? color_of(prop(sec, "mark"), ctx, 0) : -1;
+        s_ls.sel_x  = prop(sec, "sel_x")  ? eval_int(prop(sec, "sel_x"), ctx, 0) : -1;
+        s_ls.sel_w  = prop(sec, "sel_w")  ? eval_int(prop(sec, "sel_w"), ctx, 0) : -1;
+        s_ls.scale  = prop(sec, "scale")  ? eval_int(prop(sec, "scale"), ctx, 1) : 1;
