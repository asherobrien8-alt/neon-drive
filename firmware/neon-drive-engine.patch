+/* Neon Drive extension: optional list styling. Every field < 0 means "use
+ * the stock behaviour", so packages that do not set these keys render
+ * exactly as before. Filled from the list section just before draw_list(). */
+typedef struct {
+    int fg, bg, sel_fg, sel_bg, val_fg, sel_x, sel_w, mark, scale;
+    int bg_none;
+} skin_list_style_t;
+static skin_list_style_t s_ls = { -1, -1, -1, -1, -1, -1, -1, -1, 1, 0 };
+
+/* Text at 1x..4x. `transparent` skips the cell background so text can sit
+ * on gradients. 1x opaque falls through to the stock driver path. */
+static void skin_text(int x, int y, const char *s, uint16_t fg, uint16_t bg,
+                      int scale, int transparent)
+{
+    int pen = x;
+
+    if (scale < 1) scale = 1;
+    if (scale > 4) scale = 4;
+    if (scale == 1 && !transparent) {
+        display_draw_text(x, y, s, fg, bg);
+        return;
+    }
+    for (; *s; s++, pen += SKIN_FONT_W * scale) {
+        const uint8_t *g = font_glyph((uint8_t)*s);
+        int row;
+
+        if (pen >= THEME_LAYOUT_MAX_W)
+            break;
+        if (!transparent)
+            display_fill_rect(pen, y, pen + SKIN_FONT_W * scale - 1,
+                              y + 8 * scale - 1, bg);
+        for (row = 0; row < 8; row++) {
+            int col = 0;
+            while (col < 8) {
+                int start;
+                if (!(g[row] & (0x80 >> col))) { col++; continue; }
+                start = col;
+                while (col < 8 && (g[row] & (0x80 >> col)))
+                    col++;
+                display_fill_rect(pen + start * scale, y + row * scale,
+                                  pen + col * scale - 1,
+                                  y + row * scale + scale - 1, fg);
+            }
+        }
+    }
+}
