diff --git a/firmware/ui/screens/search_screen.c b/firmware/ui/screens/search_screen.c
new file mode 100644
index 0000000..63e7db0
--- /dev/null
+++ b/firmware/ui/screens/search_screen.c
@@ -0,0 +1,224 @@
+/*
+ * search_screen.c — type-to-search with three buttons (Neon Drive).
+ *
+ * The Echo Mini has no keyboard, so letters come from a wheel:
+ *   VOL +/-      spin the wheel (A..Z, 0..9, space; "GO>" once you typed)
+ *   PLAY         add the letter  (on GO>: open the results)
+ *   hold PLAY    open the results
+ *   BACK         delete a letter; on an empty query, leave
+ * Matches update live (title, artist or album contains the text) with a
+ * preview of the first four; the results open in the library song list, so
+ * playing, A-Z and BACK work exactly like everywhere else.
+ */
+#include <stdio.h>
+#include <string.h>
+
+#include "screens.h"
+#include "../theme.h"
+#include "../internal/hal.h"
+#include "../../services/media_query.h"
+
+#define SQ_MAX 16
+/* wheel position 0 is GO (only offered once something is typed) */
+static const char k_wheel[] = "\001ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789 ";
+#define WHEEL_N ((int)sizeof k_wheel - 1)
+
+static char s_q[SQ_MAX + 1];
+static int  s_wheel = 1;
+static int  s_armed;      /* PLAY went down on THIS screen (see handler) */
+
+static void sq_run(void)
+{
+    (void)mq_search_init(s_q);
+}
+
+static void sq_open_results(void)
+{
+    if (s_q[0] == '\0' || mq_filter_count() == 0u)
+        return;
+    library_cat_open_search(s_q);
+    ui_push_screen(&library_cat_screen);
+}
+
+void search_screen_open(void)
+{
+    s_q[0] = '\0';
+    s_wheel = 1;
+    ui_push_screen(&search_screen);
+}
+
+static void sq_enter(void)
+{
+    s_armed = 0;
+    sq_run();                    /* also on return from the results list */
+    ui_invalidate_all();
+}
+
+static void sq_exit(void)
+{
+    mq_done();
+}
+
+static void wheel_label(int w, char *out)
+{
+    if (k_wheel[w] == '\001')
+        strcpy(out, "GO>");
+    else if (k_wheel[w] == ' ')
+        strcpy(out, "_");
+    else {
+        out[0] = k_wheel[w];
+        out[1] = '\0';
+    }
+}
+
+static void sq_draw(void)
+{
+    char buf[40], lab[4];
+    unsigned n = s_q[0] ? mq_filter_count() : 0u;
+    int i, len = (int)strlen(s_q), x;
+
+    display_clear(THEME_COLOR_BG);
+    display_fill_rect(0, 0, 2, 13, THEME_COLOR_WARN);
+    display_draw_text(8, 4, "SEARCH", THEME_COLOR_ACCENT, THEME_COLOR_BG);
+    snprintf(buf, sizeof buf, s_q[0] ? "%u MATCH%s" : "TITLE ARTIST ALBUM",
+             n, n == 1u ? "" : "ES");
+    display_draw_text(DISPLAY_W - 6 - (int)strlen(buf) * 8, 4, buf,
+                      s_q[0] ? (n ? THEME_COLOR_WARM : THEME_COLOR_WARN)
+                             : THEME_COLOR_DIM, THEME_COLOR_BG);
+
+    /* input box: typed text + the pending wheel letter as a cursor block */
+    display_fill_rect(6, 17, DISPLAY_W - 7, 42, THEME_COLOR_ACCENT);
+    display_fill_rect(8, 19, DISPLAY_W - 9, 40, THEME_COLOR_BG);
+    ui_text_scaled(14, 22, s_q, 2, THEME_COLOR_FG);
+    x = 14 + len * 16;
+    wheel_label(s_wheel, lab);
+    display_fill_rect(x - 1, 21, x + (int)strlen(lab) * 16, 38,
+                      k_wheel[s_wheel] == '\001' ? THEME_COLOR_WARM
+                                                 : THEME_COLOR_WARN);
+    ui_text_scaled(x, 22, lab, 2, THEME_COLOR_BG);
+
+    /* the wheel: neighbours of the current letter */
+    for (i = -6; i <= 6; i++) {
+        int w = s_wheel + i;
+        char c[4];
+
+        while (w < 0) w += WHEEL_N;
+        while (w >= WHEEL_N) w -= WHEEL_N;
+        if (k_wheel[w] == '\001' && s_q[0] == '\0') {
+            c[0] = '.'; c[1] = '\0';
+        } else
+            wheel_label(w, c);
+        if (c[1] != '\0') { c[0] = '>'; c[1] = '\0'; }
+        display_draw_text(156 + i * 22, 49, c,
+                          i == 0 ? THEME_COLOR_WARN
+                                 : (i == -1 || i == 1 ? THEME_COLOR_FG
+                                                      : THEME_COLOR_DIM),
+                          THEME_COLOR_BG);
+    }
+    display_fill_rect(152, 59, 167, 60, THEME_COLOR_WARN);
+
+    /* live preview */
+    for (i = 0; i < 4 && (unsigned)i < n; i++) {
+        media_rec_t rec;
+        int y = 68 + i * 18;
+
+        if (mq_filter_get((unsigned)i, &rec) != FS_OK)
+            break;
+        display_fill_rect(6, y - 2, DISPLAY_W - 7, y + 12,
+                          i == 0 ? THEME_COLOR_SELECT_BG : THEME_COLOR_BG);
+        if (i == 0)
+            display_fill_rect(6, y - 2, 8, y + 12, THEME_COLOR_WARN);
+        snprintf(buf, sizeof buf, "%.20s", rec.title);
+        display_draw_text(14, y + 1, buf, i == 0 ? THEME_COLOR_ACCENT : THEME_COLOR_FG,
+                          i == 0 ? THEME_COLOR_SELECT_BG : THEME_COLOR_BG);
+        snprintf(buf, sizeof buf, "%.14s", rec.artist);
+        display_draw_text(DISPLAY_W - 12 - (int)strlen(buf) * 8, y + 1, buf,
+                          THEME_COLOR_DIM, i == 0 ? THEME_COLOR_SELECT_BG : THEME_COLOR_BG);
+    }
+    if (s_q[0] != '\0' && n == 0u)
+        display_draw_text(14, 70, "no matches - BACK deletes", THEME_COLOR_DIM,
+                          THEME_COLOR_BG);
+    if (n > 4u) {
+        snprintf(buf, sizeof buf, "+%u more", n - 4u);
+        display_draw_text(14, 142, buf, THEME_COLOR_DIM, THEME_COLOR_BG);
+    }
+
+    display_fill_rect(0, 152, DISPLAY_W - 1, 152, THEME_COLOR_SELECT_BG);
+    display_draw_text(6, 158,
+                      k_wheel[s_wheel] == '\001' ? "PLAY SHOW RESULTS  BACK DEL"
+                                                 : "VOL LETTER PLAY ADD BACK DEL",
+                      THEME_COLOR_DIM, THEME_COLOR_BG);
+}
+
+static void sq_handle_event(const input_event_t *ev)
+{
+    int len = (int)strlen(s_q);
+
+    switch (ev->type) {
+    case KEY_UP:
+    case KEY_DOWN:
+        if (ev->kind != INPUT_PRESS && ev->kind != INPUT_REPEAT)
+            return;
+        do {
+            s_wheel += (ev->type == KEY_DOWN) ? 1 : -1;
+            if (s_wheel < 0) s_wheel = WHEEL_N - 1;
+            if (s_wheel >= WHEEL_N) s_wheel = 0;
+        } while (s_wheel == 0 && s_q[0] == '\0');   /* no GO on an empty query */
+        ui_invalidate_all();
+        break;
+    case KEY_SELECT:
+        /* The PLAY press that opened this screen ends here: its RELEASE
+         * must not type a letter, so only act on presses seen here. */
+        if (ev->kind == INPUT_PRESS) {
+            s_armed = 1;
+            return;
+        }
+        if (!s_armed)
+            return;
+        if (ev->kind == INPUT_LONG) {
+            s_armed = 0;
+            sq_open_results();
+            return;
+        }
+        if (ev->kind != INPUT_RELEASE)
+            return;
+        s_armed = 0;
+        if (ev->long_press)
+            return;
+        if (s_wheel == 0) {
+            sq_open_results();
+            return;
+        }
+        if (len < SQ_MAX) {
+            s_q[len] = k_wheel[s_wheel];
+            s_q[len + 1] = '\0';
+            sq_run();
+            ui_invalidate_all();
+        }
+        break;
+    case KEY_BACK:
+        if (ev->kind != INPUT_PRESS)
+            return;
+        if (len > 0) {
+            s_q[len - 1] = '\0';
+            if (s_q[0] == '\0' && s_wheel == 0)
+                s_wheel = 1;
+            sq_run();
+            ui_invalidate_all();
+        } else {
+            ui_pop_screen();
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+const ui_screen_t search_screen = {
+    "search",
+    sq_enter,
+    sq_exit,
+    sq_draw,
+    sq_handle_event,
+    0,
+};
