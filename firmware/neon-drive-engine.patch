index 0acfd29..a335740 100644
--- a/firmware/services/art_pack.c
+++ b/firmware/services/art_pack.c
@@ -395,3 +395,50 @@ int art_pack_draw(int x, int y, int large)
     fs_close(f);
     return left == 0u ? 0 : -1;
 }
+
+/* ---- Neon Drive: raw RGB565 pictures ------------------------------------
+ * Stream a w x h window of a raw little-endian RGB565 file (stride sw pixels,
+ * window origin sx,sy) to the framebuffer at (x,y), through the same 512 B
+ * sector buffer the cover art uses: no new RAM, no decoding. Rows are read
+ * in order, so the seeks only move forward (cheap since fs_seek keeps the
+ * cluster walk). `pump` (optional) runs every few rows to keep audio fed. */
+int art_pack_blit_file(const char *path, int x, int y, int w, int h,
+                       int sx, int sy, int sw, void (*pump)(void))
+{
+    fs_file_t *f;
+    int r;
+
+    if (path == 0 || w <= 0 || h <= 0 || sw < w || sx < 0 || sy < 0)
+        return -1;
+    f = fs_open_read(path);
+    if (f == 0)
+        return -1;
+    for (r = 0; r < h; r++) {
+        long off = ((long)(sy + r) * sw + sx) * 2L;
+        uint32_t left = (uint32_t)w * 2u;
+        int col = 0;
+
+        if (y + r >= DISPLAY_H)
+            break;
+        if ((r == 0 || w != sw) && fs_seek(f, off) != off)
+            break;
+        while (left > 0u) {
+            uint32_t chunk = left > HDR_BYTES ? HDR_BYTES : left;
+            long n = fs_read(f, s_buf, chunk);
+
+            if (n <= 1)
+                goto done;
+            n &= ~1L;
+            if (y + r >= 0)
+                display_blit_span(x + col, y + r, (int)(n / 2),
+                                  (const uint16_t *)(const void *)s_buf);
+            col += (int)(n / 2);
+            left -= (uint32_t)n;
+        }
+        if (pump != 0 && (r & 15) == 15)
+            pump();
+    }
+done:
+    fs_close(f);
+    return 0;
+}
