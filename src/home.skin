x3=296
y3=92
color={pink}

[m2]
type=triangle
x1=182
y1=92
x2=236
y2=69
x3=294
y3=92
color={mtn}

[m3]
type=triangle
x1=-10
y1=92
x2=22
y2=76
x3=70
y3=92
color={mtn}

[palmL]
type=bitmap
asset=palm
x=18
y=60
color={pink}
bg=none

[palmR]
type=bitmap
asset=palm
x=278
y=60
flip=1
color={pink}
bg=none

[logo2]
type=text
x=8
y=7
text="NEON DRIVE"
scale=2
color={cyan_dk}
bg=none

[logo]
type=text
x=6
y=5
text="NEON DRIVE"
scale=2
color={pink}
bg=none

[np]
type=text
x=6
y=25
text=(playing ? "> " : "| ") + title + " - " + artist
maxc=36
color={cyan}
bg=none
visible=playing || paused

[bat]
type=text
x=314
y=5
text=(battery < 0 ? "--" : battery + "%")
align=right
color={white}
bg=none

