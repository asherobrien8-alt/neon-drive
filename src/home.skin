[t4]
type=quad
x=4
y=132
w=152
h=22
skew=8
lw=2
color=(sel == 4 ? tr : {sky})
line=(sel == 4 ? tr : {cyan})

[l0]
type=text
x=16
y=27
text="FILE BROWSER"
color=(sel == 0 ? {white} : {cyan})
bg=none

[l1]
type=text
x=16
y=55
text="MEDIA LIBRARY"
color=(sel == 1 ? {white} : {cyan})
bg=none

[l2]
