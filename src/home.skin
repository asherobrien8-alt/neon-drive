# HOME — live retrowave wallpaper: a wedge car cruising a neon road into a
# striped sun. Only the road band (y 92-145) and the menu bar animate.
[skin]
refresh_ms=80
dyn=0,92,319,145
dyn2=0,146,319,169

[vars]
p=mod(t / 3, 1024)
z0=mod(p, 1024)
z1=mod(p + 256, 1024)
z2=mod(p + 512, 1024)
z3=mod(p + 768, 1024)
y0=92 + (53 * z0 / 32) * z0 / 32768
y1=92 + (53 * z1 / 32) * z1 / 32768
y2=92 + (53 * z2 / 32) * z2 / 32768
y3=92 + (53 * z3 / 32) * z3 / 32768
bob=sin(t, 700, 1)

# ---------------------------------------------------------------- sky
[sky]
type=gradient
x=0
y=0
w=W
h=40
from={sky_top}
to={sky_mid}
dir=vertical

[sky2]
type=fill
x=0
y=40
w=W
h=52
color={sky_mid}

[st1]
type=fill
x=212
y=9
w=1
h=1
color={star}

[st2]
type=fill
x=262
y=24
w=2
h=1
color={star}

[st3]
type=fill
x=150
y=30
w=1
h=1
color={star}

[sun]
type=roundrect
x=124
y=42
w=72
h=72
r=36
color={sun_hi}

[sun2]
type=roundrect
x=124
y=52
w=72
h=72
r=36
color={sun_or}

[sun3]
type=roundrect
x=124
y=62
w=72
h=72
r=36
color={sun}

[s1]
type=fill
x=120
y=68
w=80
h=2
color={sky_mid}

[s2]
type=fill
x=120
y=75
w=80
h=3
color={sky_mid}

[s3]
type=fill
x=120
y=82
w=80
h=4
color={sky_mid}

[m1e]
type=triangle
x1=40
y1=92
x2=96
y2=61
x3=150
y3=92
color={pink}

[m1]
type=triangle
x1=42
y1=92
x2=96
y2=63
x3=148
y3=92
color={mtn}

[m2e]
type=triangle
x1=180
