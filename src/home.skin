# HOME — neon tag menu + night city (from Jace's mockup).
# Selected tag flickers like a failing neon tube, stars twinkle, the sun
# glows with rings radiating out, windows and antenna lights live.
# Everything animates, so the whole screen refreshes (~10 fps).
[skin]
refresh_ms=90
refresh_h=170

[vars]
fk=(mod(t, 2300) < 70 || (mod(t, 2300) > 2150 && mod(t, 2300) < 2185) || mod(t, 1300) < 22)
tr=(fk ? {tag_dim} : {tag})
ph=mod(t / 70, 14)
pq=mod(t / 70 + 7, 14)
c1=(ph < 5 ? {ring1} : (ph < 10 ? {ring2} : {ring3}))
c2=(pq < 5 ? {ring1} : (pq < 10 ? {ring2} : {ring3}))
al=(mod(t, 1400) < 700 ? {red} : {ring3})

[a]
type=fill
x=0
y=0
w=W
h=H
color={sky}

[hm]
type=text
x=8
y=6
text="HOME"
color={cyan_dk}
bg=none

[bt]
type=text
x=154
y=6
text=(battery < 0 ? "--" : battery + "%")
align=right
color={dim}
bg=none

# ---------------------------------------------------------------- tags
[t0]
type=quad
x=4
y=20
w=152
h=22
skew=8
lw=2
color=(sel == 0 ? tr : {sky})
line=(sel == 0 ? tr : {cyan})

[t1]
type=quad
x=4
y=48
w=152
h=22
skew=8
lw=2
color=(sel == 1 ? tr : {sky})
line=(sel == 1 ? tr : {cyan})

[t2]
type=quad
x=4
y=76
w=152
h=22
skew=8
lw=2
color=(sel == 2 ? tr : {sky})
line=(sel == 2 ? tr : {cyan})

[t3]
