# HOME v3 — painted cyberpunk city (img/city.565) + Night-City style tags.
# The city is one streamed picture; only small patches animate (dyn rects),
# so the screen costs a few KB per frame instead of a full redraw:
#   menu tags (flicker/glitch), the hologram billboard, three neon signs
#   that stutter, and traffic sliding over the bridge.
[skin]
refresh_ms=90
refresh_h=170
dyn=0,20,174,146
dyn2=232,22,281,79
dyn3=195,69,207,92
dyn4=295,73,307,96
dyn5=262,104,316,114
dyn6=150,135,319,137

[vars]
fk=(mod(t, 2300) < 70 || (mod(t, 2300) > 2150 && mod(t, 2300) < 2185) || mod(t, 1300) < 22)
tr=(fk ? (mod(t, 60) < 30 ? {tag_dim} : {cyan_dk}) : {tag})
jx=(fk ? 2 - mod(t / 20, 5) : 0)
gy=27 + mod(t / 30, 13)
sa=(mod(t, 3100) < 2700 || mod(t, 140) < 60)
sb=(mod(t + 1700, 4300) < 3900 || mod(t, 110) < 40)
sc=(mod(t + 900, 5200) < 4300 || mod(t, 190) < 70)
ph=mod(t, 20000)
ad=(ph >= 10000 && (ph > 10360 || mod(t, 90) < 50))
rs=(ad == 0 && (ph < 1500 || (ph >= 10000 && ph < 10400)))

[a]
type=image
file="img/city.565"
x=0
y=0
w=320
h=170

# ---------------------------------------------------------------- header
[lg]
type=text
x=8
y=5
text="NEON"
color={white}
bg=none

[lg2]
type=text
x=40
y=5
text="//DRIVE"
color={tag}
bg=none

[ru]
type=fill
x=8
y=15
w=100
h=1
color={tag}

[ru2]
type=fill
x=108
y=15
w=30
h=1
color={cyan_dk}

[ft]
type=text
x=8
y=158
text="SYS.ONLINE"
color={white}
bg=none

[ft2]
type=text
x=96
y=158
text="// 2077"
color={tag}
bg=none

# ---------------------------------------------------------------- tags
[t0]
type=quad
x=4
y=26
w=160
h=23
skew=8
lw=1
color=(sel == 0 ? tr : {sky})
line=(sel == 0 ? tr : {cyan_dk})
dyn=1

[t1]
type=quad
x=4
y=56
w=160
h=23
skew=8
lw=1
color=(sel == 1 ? tr : {sky})
line=(sel == 1 ? tr : {cyan_dk})
dyn=1

[t2]
type=quad
x=4
y=86
w=160
h=23
skew=8
lw=1
color=(sel == 2 ? tr : {sky})
line=(sel == 2 ? tr : {cyan_dk})
dyn=1

[t3]
type=quad
x=4
y=116
w=160
h=23
skew=8
lw=1
color=(sel == 3 ? tr : {sky})
line=(sel == 3 ? tr : {cyan_dk})
dyn=1

# glitch slice through the selected tag while it stutters
[sl]
type=fill
x=18
y=sel * 30 + gy - 4
w=96 + mod(t, 40)
h=2
color={cyan}
visible=fk
dyn=1

# selected-row marker, inside the tag so it repaints clean
[mk]
type=fill
x=12
y=sel * 30 + 34
w=3
h=7
color=(fk ? {cyan} : {white})
dyn=1

[l0]
type=text
x=22 + (sel == 0 ? jx : 0)
y=34
text="01  MUSIC"
color=(sel == 0 ? {white} : {cyan})
bg=none
dyn=1

[l1]
type=text
x=22 + (sel == 1 ? jx : 0)
y=64
text="02  NOW PLAYING"
color=(sel == 1 ? {white} : {cyan})
bg=none
dyn=1

[l2]
type=text
x=22 + (sel == 2 ? jx : 0)
y=94
text="03  MUSIC SETUP"
color=(sel == 2 ? {white} : {cyan})
bg=none
dyn=1

[l3]
type=text
x=22 + (sel == 3 ? jx : 0)
y=124
text="04  SYSTEM"
color=(sel == 3 ? {white} : {cyan})
bg=none
dyn=1

[m]
type=list
axis=vertical
y=26
height=30
rows=4
selected=0
item0=MUSIC:library
item1=NOW PLAYING:player
item2=MUSIC SETUP:settings
item3=SYSTEM:system
visible=0

# ---------------------------------------------------------------- city life
# main tower: hologram loop, or every other 10 s a dumb ad carrying the
# battery level (bolt while charging). Leaving the ad repaints the facade.
[rst]
type=image
file="img/city.565"
x=232
y=22
w=50
h=58
sx=232
sy=22
sw=320
visible=rs
dyn=1

[ho]
type=image
file="img/holo_" + mod(t / 160, 4) + ".565"
x=242
y=30
w=26
h=44
visible=(ad == 0)
dyn=1

[adv]
type=image
file="img/ad_" + mod(t / 20000, 2) + ".565"
x=232
y=22
w=50
h=58
visible=ad
dyn=1

[bat]
type=text
x=(charging ? 262 : 257)
y=69
text=(battery < 0 ? "--" : battery + "%")
align=center
color=(battery >= 0 && battery < 15 ? {tag} : {white})
bg=none
visible=ad
dyn=1

[bolt]
type=image
file="img/bolt.565"
x=236
y=67
w=7
h=11
visible=ad && charging
dyn=1

[sa1]
type=image
file="img/city.565"
x=195
y=69
w=13
h=24
sx=195
sy=69
sw=320
visible=sa
dyn=1

[sa0]
type=image
file="img/signs_off.565"
x=195
y=69
w=13
h=24
sx=0
sy=0
sw=55
visible=(sa == 0)
dyn=1

[sb1]
type=image
file="img/city.565"
x=295
y=73
w=13
h=24
sx=295
sy=73
sw=320
visible=sb
dyn=1

[sb0]
type=image
file="img/signs_off.565"
x=295
y=73
w=13
h=24
sx=0
sy=24
sw=55
visible=(sb == 0)
dyn=1

[sc1]
type=image
file="img/city.565"
x=262
y=104
w=55
h=11
sx=262
sy=104
sw=320
visible=sc
dyn=1

[sc0]
type=image
file="img/signs_off.565"
x=262
y=104
w=55
h=11
sx=0
sy=48
sw=55
visible=(sc == 0)
dyn=1

# bridge traffic: restore the deck, then slide headlights / tail lights
[br]
type=image
file="img/city.565"
x=150
y=135
w=170
h=3
sx=150
sy=135
sw=320
dyn=1

[hl]
type=dots
x=150 + mod(t / 25, 24)
y=135
w=146
h=1
sx=24
dw=4
dh=1
density=55
seed=5
color={win_y}
dyn=1

[tl]
type=dots
x=174 - mod(t / 35, 24)
y=137
w=146
h=1
sx=24
dw=3
dh=1
density=50
seed=9
color={tag}
dyn=1
