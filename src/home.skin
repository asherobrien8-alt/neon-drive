x=16
y=83
text="PLAYING"
color=(sel == 2 ? {white} : {cyan})
bg=none

[l3]
type=text
x=16
y=111
text="MUSIC SETTINGS"
color=(sel == 3 ? {white} : {cyan})
bg=none

[l4]
type=text
x=16
y=139
text="SYSTEM SETTINGS"
color=(sel == 4 ? {white} : {cyan})
bg=none

[m]
type=list
axis=vertical
y=20
height=28
rows=5
selected=2
item0=FILE BROWSER:files
item1=MEDIA LIBRARY:library
item2=PLAYING:player
item3=MUSIC SETTINGS:settings
item4=SYSTEM SETTINGS:system
visible=0

