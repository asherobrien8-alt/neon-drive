# NOW PLAYING — big title, mini sunset with the car, and the VOLUME RUNNER:
# a glowing runner stands on the volume track at the current level and
# sprints to the new level (facing that way) whenever the volume changes.
[skin]
refresh_ms=60
dyn=0,0,319,18
dyn2=0,106,319,143
dyn3=0,144,319,169

[vars]
tx=10 + vol_lv * 284 / 80
fl=(tx < rx ? 1 : (tx > rx ? 0 : fl))
mv=(tx != rx)
lt=(mv ? t : lt)
rx=(abs(tx - rx) > 320 ? tx : rx + clamp(tx - rx, -6, 6))
rn=(t - lt < 450)
fr=(rn ? mod(t, 220) < 110 : 1)

[bg]
type=fill
x=0
y=0
w=W
h=H
color={navy}

# ---------------------------------------------------------------- top (dyn)
[top]
type=fill
x=0
y=0
w=W
h=18
color={navy}
dyn=1

[state]
type=text
x=8
y=6
text=(playing ? "PLAY" : (paused ? "PAUSE" : "STOP"))
color=(playing ? {cyan} : {dim})
dyn=1

[trk]
type=text
x=160
y=6
text=(pl_n > 0 ? "TRACK " + pl_i + "/" + pl_n : "")
align=center
color={dim}
dyn=1

[bat]
type=text
x=312
y=6
text=(battery < 0 ? "--" : battery + "%")
align=right
color={white}
dyn=1

# ---------------------------------------------------------------- info
[npl]
type=text
x=8
y=26
text="NOW PLAYING"
color={red}

[title]
type=text
x=8
y=38
text=title
scale=2
maxc=12
color={white}

[by]
type=text
x=8
y=60
text="BY"
color={red}

[artist]
type=text
x=30
y=60
text=artist
maxc=22
color={white}

[album]
type=text
x=8
y=72
text=album
maxc=25
color={dim}

[badge]
type=roundrect
x=8
y=86
w=136
h=14
r=2
color={cyan}

[badge2]
type=fill
x=9
y=87
w=134
h=12
color={navy}

[fmt]
type=text
x=76
y=89
text=(bits > 0 ? bits + "/" + (rate / 1000) + "K" : "AUDIO") + (kbps > 0 ? " " + kbps + "KBPS" : "")
align=center
color={cyan}

[hr]
type=text
x=150
y=89
text="HI-RES"
color={lime}
visible=bits > 16 || rate > 48000

# ---------------------------------------------------------------- mini sunset
[sky]
type=gradient
x=212
y=24
w=100
h=60
from={sky_top}
to={sky_mid}
dir=vertical

[sun]
type=roundrect
x=232
y=36
w=60
h=60
r=30
color={sun_hi}

[sun2]
type=roundrect
x=232
y=45
w=60
h=60
r=30
color={sun}

[s1]
type=fill
x=232
y=64
w=60
h=2
color={sky_mid}

[s2]
type=fill
x=232
y=70
w=60
h=3
color={sky_mid}

[s3]
type=fill
x=232
y=77
w=60
h=4
color={sky_mid}

[gnd]
type=fill
x=212
y=84
w=100
h=20
color={ground}

[rd]
type=triangle
x1=256
y1=84
x2=268
y2=84
x3=312
y3=104
color={road}

[rd2]
type=triangle
x1=256
y1=84
x2=312
y2=104
x3=212
y3=104
color={road}

[hz]
type=fill
x=212
y=84
w=100
h=1
color={pink}

[cd]
type=bitmap
asset=car_d
x=230
y=81
color={car_dk}
bg=none

[tail]
type=fill
x=235
y=89
w=54
h=3
color={tail}

[cb]
type=bitmap
asset=car_b
x=230
y=81
color={car}
bg=none

[cn]
type=bitmap
asset=car_n
x=230
y=81
color={cyan}
bg=none

# ---------------------------------------------------------------- volume runner (dyn)
[lane]
type=fill
x=0
y=106
w=W
h=38
color={navy}
dyn=1

[track]
type=bar
x=10
y=136
w=300
h=3
value=vol_lv
max=80
color={cyan}
bg={faint}
dyn=1

[vol]
type=text
x=10
y=110
text="VOL " + vol_lv
color=(rn ? {lime} : {dim})
dyn=1

[spd1]
type=fill
x=(fl ? rx + 18 : rx - 14)
y=118
w=10
h=1
color={cyan_dk}
visible=rn
dyn=1

[spd2]
type=fill
x=(fl ? rx + 20 : rx - 18)
y=124
w=12
h=1
color={cyan_dk}
visible=rn
dyn=1

[g1]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx - 1
y=112
flip=fl
color={glow}
bg=none
dyn=1

[g2]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx + 1
y=112
flip=fl
color={glow}
bg=none
dyn=1

[g3]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx
y=111
flip=fl
color={glow}
bg=none
dyn=1

[body]
type=bitmap
asset=(fr ? run_b : run_a)
x=rx
y=112
flip=fl
color={camo}
bg=none
dyn=1

[hi]
type=bitmap
asset=(fr ? run_bh : run_ah)
x=rx
y=112
flip=fl
color={shoe}
bg=none
dyn=1

# ---------------------------------------------------------------- progress (dyn)
[pbg]
type=fill
x=0
y=144
w=W
h=26
color={navy}
dyn=1

[prog]
type=bar
x=8
y=148
w=304
h=3
value=pos_ms
max=dur_ms
color={cyan}
bg={faint}
dyn=1

[pos]
type=text
x=8
y=156
text=pos_fmt
color={white}
dyn=1

[mode]
type=text
x=160
y=156
text=(shuffle ? "SHUF " : "") + (repeat == 2 ? "REP1" : (repeat == 1 ? "REP" : ""))
align=center
color={pink}
dyn=1

[dur]
type=text
x=312
y=156
text=dur_fmt
align=right
color={dim}
dyn=1
