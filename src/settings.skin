# SETTINGS — cyber terminal: prompt header, bracketed frame, inverted cyan
# selection, lime values, status line. Static (no CPU while idle).
[bg]
type=fill
x=0
y=0
w=W
h=H
color={navy}

[prompt]
type=text
x=6
y=5
text="SYS://CONFIG_"
color={lime}

[ver]
type=text
x=314
y=5
text="NEON-DRIVE.v1"
align=right
color={faint}

[rule]
type=fill
x=6
y=16
w=308
h=1
color={cyan_dk}

[tl]
type=fill
x=4
y=20
w=10
h=2
color={pink}

[tl2]
type=fill
x=4
y=20
w=2
h=10
color={pink}

[tr]
type=fill
x=306
y=20
w=10
h=2
color={pink}

[tr2]
type=fill
x=314
y=20
w=2
h=10
color={pink}

[bl]
type=fill
x=4
y=144
w=10
h=2
color={pink}

[bl2]
type=fill
x=4
y=136
w=2
h=10
color={pink}

[br]
type=fill
x=306
y=144
w=10
h=2
color={pink}

[br2]
type=fill
x=314
y=136
w=2
h=10
color={pink}

[menu]
type=list
axis=vertical
x=18
y=24
height=17
rows=7
source=settings
sel_fg={navy}
sel_bg={cyan}
sel_x=8
sel_w=304
val_fg={lime}

[scan]
type=fill
x=8
y=148
w=304
h=1
color={faint}

[st]
type=text
x=6
y=156
text="> STATUS:ONLINE  PWR " + (battery < 0 ? "--" : battery + "%")
color={cyan}

[pos]
type=text
x=314
y=156
text="[" + (sel + 1) + "/" + n + "]"
align=right
color={pink}
